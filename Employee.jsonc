{
  "name": "Employee",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Codice univoco permanente del dipendente (es. EMP-001)"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "contract_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "hourly_cost": {
      "type": "number",
      "description": "Costo orario del dipendente in euro, usato per calcoli economici (non limita le assegnazioni)"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "phone",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}